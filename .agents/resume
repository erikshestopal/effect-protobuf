#!/usr/bin/env bash
set -euo pipefail

readonly runner="$HOME/.local/share/protobuf-conformance-35.1/conformance_test_runner"
readonly installed_runner="node_modules/protobuf-conformance/bin/conformance_test_runner-linux-x64"

if [[ -x "$runner" && -e "$installed_runner" ]] && ! cmp -s "$runner" "$installed_runner"; then
  cp "$runner" "$installed_runner"
  chmod +x "$installed_runner"
fi
