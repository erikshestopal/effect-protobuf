#!/usr/bin/env bash
set -euo pipefail

readonly node_version=26.4.0
readonly bun_version=1.3.14
readonly buf_version=1.72.0
readonly protobuf_version=35.1
readonly local_bin="$HOME/.local/bin"
readonly local_share="$HOME/.local/share"

mkdir -p "$local_bin" "$local_share"

if ! dpkg -s ca-certificates curl unzip xz-utils >/dev/null 2>&1; then
  sudo apt-get update -qq
  sudo apt-get install -y -qq ca-certificates curl unzip xz-utils
fi

node_home="$local_share/node-v$node_version"
if [[ ! -x "$node_home/bin/node" ]]; then
  archive=$(mktemp)
  curl -fsSL "https://nodejs.org/dist/v$node_version/node-v$node_version-linux-x64.tar.xz" -o "$archive"
  rm -rf "$node_home"
  mkdir -p "$node_home"
  tar -xJf "$archive" --strip-components=1 -C "$node_home"
  rm -f "$archive"
fi
for executable in node npm npx corepack; do
  ln -sfn "$node_home/bin/$executable" "$local_bin/$executable"
done

bun_home="$local_share/bun-v$bun_version"
if [[ ! -x "$bun_home/bun" ]]; then
  archive=$(mktemp)
  extract_dir=$(mktemp -d)
  curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v$bun_version/bun-linux-x64.zip" -o "$archive"
  unzip -q "$archive" -d "$extract_dir"
  rm -rf "$bun_home"
  mkdir -p "$bun_home"
  mv "$extract_dir/bun-linux-x64/bun" "$bun_home/bun"
  rm -rf "$archive" "$extract_dir"
fi
ln -sfn "$bun_home/bun" "$local_bin/bun"
ln -sfn "$bun_home/bun" "$local_bin/bunx"

if [[ ! -x "$local_bin/buf" ]] || [[ "$($local_bin/buf --version)" != "$buf_version" ]]; then
  curl -fsSL "https://github.com/bufbuild/buf/releases/download/v$buf_version/buf-Linux-x86_64" -o "$local_bin/buf"
  chmod +x "$local_bin/buf"
fi

protoc_home="$local_share/protoc-$protobuf_version"
if [[ ! -x "$protoc_home/bin/protoc" ]]; then
  archive=$(mktemp)
  curl -fsSL \
    "https://github.com/protocolbuffers/protobuf/releases/download/v$protobuf_version/protoc-$protobuf_version-linux-x86_64.zip" \
    -o "$archive"
  rm -rf "$protoc_home"
  mkdir -p "$protoc_home"
  unzip -q "$archive" -d "$protoc_home"
  rm -f "$archive"
fi
ln -sfn "$protoc_home/bin/protoc" "$local_bin/protoc"

export PATH="$local_bin:$PATH"
bun install --frozen-lockfile

node --version
bun --version
buf --version
protoc --version
