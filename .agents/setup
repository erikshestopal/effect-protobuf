#!/usr/bin/env bash
set -euo pipefail

readonly node_version=26.4.0
readonly bun_version=1.3.14
readonly buf_version=1.72.0
readonly protobuf_version=35.1
readonly bazelisk_version=1.29.0
readonly local_bin="$HOME/.local/bin"
readonly local_share="$HOME/.local/share"

mkdir -p "$local_bin" "$local_share"

if ! dpkg -s build-essential ca-certificates curl openjdk-17-jre-headless unzip xz-utils >/dev/null 2>&1; then
  sudo apt-get update -qq
  sudo apt-get install -y -qq build-essential ca-certificates curl openjdk-17-jre-headless unzip xz-utils
fi

node_home="$local_share/node-v$node_version"
if [[ ! -x "$node_home/bin/node" ]]; then
  archive=$(mktemp)
  curl -fsSL "https://nodejs.org/dist/v$node_version/node-v$node_version-linux-x64.tar.xz" -o "$archive"
  rm -rf "$node_home"
  mkdir -p "$node_home"
  tar -xJf "$archive" --strip-components=1 -C "$node_home"
  rm -f "$archive"
fi
for executable in node npm npx corepack; do
  ln -sfn "$node_home/bin/$executable" "$local_bin/$executable"
done

bun_home="$local_share/bun-v$bun_version"
if [[ ! -x "$bun_home/bun" ]]; then
  archive=$(mktemp)
  extract_dir=$(mktemp -d)
  curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v$bun_version/bun-linux-x64.zip" -o "$archive"
  unzip -q "$archive" -d "$extract_dir"
  rm -rf "$bun_home"
  mkdir -p "$bun_home"
  mv "$extract_dir/bun-linux-x64/bun" "$bun_home/bun"
  rm -rf "$archive" "$extract_dir"
fi
ln -sfn "$bun_home/bun" "$local_bin/bun"
ln -sfn "$bun_home/bun" "$local_bin/bunx"

if [[ ! -x "$local_bin/buf" ]] || [[ "$($local_bin/buf --version)" != "$buf_version" ]]; then
  curl -fsSL "https://github.com/bufbuild/buf/releases/download/v$buf_version/buf-Linux-x86_64" -o "$local_bin/buf"
  chmod +x "$local_bin/buf"
fi

protoc_home="$local_share/protoc-$protobuf_version"
if [[ ! -x "$protoc_home/bin/protoc" ]]; then
  archive=$(mktemp)
  curl -fsSL \
    "https://github.com/protocolbuffers/protobuf/releases/download/v$protobuf_version/protoc-$protobuf_version-linux-x86_64.zip" \
    -o "$archive"
  rm -rf "$protoc_home"
  mkdir -p "$protoc_home"
  unzip -q "$archive" -d "$protoc_home"
  rm -f "$archive"
fi
ln -sfn "$protoc_home/bin/protoc" "$local_bin/protoc"

bazelisk="$local_share/bazelisk-v$bazelisk_version"
if [[ ! -x "$bazelisk" ]]; then
  curl -fsSL \
    "https://github.com/bazelbuild/bazelisk/releases/download/v$bazelisk_version/bazelisk-linux-amd64" \
    -o "$bazelisk"
  chmod +x "$bazelisk"
fi
ln -sfn "$bazelisk" "$local_bin/bazel"
ln -sfn "$bazelisk" "$local_bin/bazelisk"

export PATH="$local_bin:$PATH"
bun install --frozen-lockfile

runner_home="$local_share/protobuf-conformance-$protobuf_version"
runner="$runner_home/conformance_test_runner"
if [[ ! -x "$runner" ]]; then
  source_home="$HOME/.cache/effect-protobuf/protobuf-$protobuf_version"
  archive=$(mktemp)
  curl -fsSL \
    "https://github.com/protocolbuffers/protobuf/releases/download/v$protobuf_version/protobuf-$protobuf_version.tar.gz" \
    -o "$archive"
  rm -rf "$source_home"
  mkdir -p "$source_home"
  tar -xzf "$archive" --strip-components=1 -C "$source_home"
  rm -f "$archive"
  (
    cd "$source_home"
    bazelisk --batch --output_user_root="$HOME/.cache/bazel-effect-protobuf" \
      build --jobs="$(nproc)" //conformance:conformance_test_runner \
      --noshow_progress
  )
  mkdir -p "$runner_home"
  cp "$source_home/bazel-bin/conformance/conformance_test_runner" "$runner"
fi

installed_runner="node_modules/protobuf-conformance/bin/conformance_test_runner-linux-x64"
if [[ ! -x "$installed_runner" ]] || ! cmp -s "$runner" "$installed_runner"; then
  cp "$runner" "$installed_runner"
  chmod +x "$installed_runner"
fi

node --version
bun --version
buf --version
protoc --version
